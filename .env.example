# omochi environment variables.
# Copy to .env (git-ignored) for local development. Do NOT put real values here.
# .env is loaded automatically only in development / test (dotenv gem).

# --- Rails ---
# Port for the web process started by bin/dev (default: 3000).
# PORT=3000
# Directory where production SQLite files are stored (default: storage).
# OMOCHI_STORAGE_DIR=/var/lib/omochi
# Number of Solid Queue worker processes (default: 1).
# JOB_CONCURRENCY=1

# --- Docker Agent Execution (Phase 2 & Phase 7) ---
# Agent runtime: "mock" (default, Ruby mock agent) or "antigravity" (Google Antigravity Agent).
# OMOCHI_AGENT_RUNTIME=mock
# Container image used to run the Agent (default: ruby:4.0; for Antigravity: omochi-agent:antigravity).
# OMOCHI_AGENT_IMAGE=ruby:4.0
# Network isolation: "none" (default for mock) or "bridge" (required for Antigravity LLM API calls).
# OMOCHI_DOCKER_NETWORK=none
# Gemini API Key for Antigravity LLM inference (injected into container when runtime is antigravity).
# GEMINI_API_KEY=
# Primary Gemini model for Antigravity (default: gemini-3.5-flash).
# GEMINI_MODEL=gemini-3.5-flash
# Optional smart/escalation model for coding, deep reasoning, and PR contexts.
# Example: set GEMINI_MODEL=gemini-3.1-flash-lite and GEMINI_SMART_MODEL=gemini-3.5-flash.
# GEMINI_SMART_MODEL=gemini-3.5-flash
# Resource and execution limits for each Agent Container.
# OMOCHI_AGENT_MEMORY=512m
# OMOCHI_AGENT_CPUS=1.0
# OMOCHI_AGENT_PIDS_LIMIT=128
# OMOCHI_AGENT_TIMEOUT_SECONDS=300
# OMOCHI_AGENT_HEARTBEAT_TIMEOUT_SECONDS=180
# Host directory where per-Quest workspaces are stored (default: storage/workspaces).
# OMOCHI_WORKSPACES_DIR=storage/workspaces

# --- Slack (Phase 3, Socket Mode) ---
# Host-side only. Never passed to Agent Containers.
# Bot User OAuth Token (xoxb-...).
SLACK_BOT_TOKEN=
# App-Level Token with connections:write for Socket Mode (xapp-...).
SLACK_APP_TOKEN=

# --- GitHub App (Phase 5) ---
# Host-side only. Never passed to Agent Containers.
# App ID (numeric integer).
GITHUB_APP_ID=
# App Slug / Bot name (default: omochi).
GITHUB_APP_SLUG=omochi
# Default repository when none is specified in a Quest (default: hamajyotan/omochi).
GITHUB_REPOSITORY=hamajyotan/omochi
# Comma-separated list of repositories accessible to omochi (e.g. hamajyotan/omochi,example/app).
GITHUB_REPOSITORIES=hamajyotan/omochi
# Webhook secret for HMAC-SHA256 signature verification.
GITHUB_WEBHOOK_SECRET=
# GitHub App Private Key in PEM format (or path to .pem file).
# Single-line format: GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GITHUB_PRIVATE_KEY=

# --- Slack OAuth / OpenID Connect Dashboard Authentication ---
# Host-side only. Client ID and Secret from Slack App (App Credentials).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Restrict omochi (Dashboard login & Socket Mode events) to a single Slack Workspace ID (e.g. T01234567).
SLACK_TEAM_ID=
# Optional: comma-separated list of Slack User IDs (e.g. U01234567) allowed to log in.
ALLOWED_SLACK_USERS=
