<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "omochi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="omochi">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to root_path, class: "site-header__brand" do %>
        <span>🍡</span> omochi
      <% end %>
      <nav>
        <% if logged_in? %>
          <%= link_to quests_path do %>
            📜 Quests
          <% end %>
          <%= link_to new_quest_path do %>
            ✨ New Quest
          <% end %>
          <div class="user-menu">
            <% if current_user["avatar_url"].present? %>
              <%= image_tag current_user["avatar_url"], class: "avatar", alt: current_user["login"] %>
            <% end %>
            <span class="user-menu__login mono">@<%= current_user["login"] %></span>
            <%= button_to "Log out", logout_path, method: :delete, class: "btn btn--small btn--secondary", data: { turbo: false } %>
          </div>
        <% else %>
          <%= link_to "🔐 Log in", login_path, class: "btn btn--small" unless current_page?(login_path) %>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <% if notice %><p class="flash flash--notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash--alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
