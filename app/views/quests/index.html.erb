<% content_for :title, "Quests | omochi" %>

<%= turbo_stream_from :quests %>

<div class="page-header">
  <h1><span>📜</span> Quests</h1>
  <nav class="status-filters" aria-label="Status filter">
    <%= link_to "All", quests_path, class: ("active" if @status_filter.nil?), data: { turbo_frame: "quests_content" } %>
    <% Quest.statuses.each_key do |status| %>
      <%= link_to status, quests_path(status: status), class: ("active" if @status_filter == status), data: { turbo_frame: "quests_content" } %>
    <% end %>
  </nav>
</div>

<%= turbo_frame_tag "quests_content" do %>
  <% if @quests.empty? %>
    <p class="empty">🍡 Quest はまだありませんにゃ。<%= link_to "✨ 新しい Quest を作成する", new_quest_path, data: { turbo: false } %></p>
  <% else %>
    <table class="table">
      <thead>
        <tr>
          <th>Quest ID</th>
          <th>Title</th>
          <th>Status</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody id="quests_rows">
        <% @quests.each do |quest| %>
          <%= render "quests/quest_row", quest: quest %>
        <% end %>
      </tbody>
    </table>

    <% if @total_pages > 1 %>
      <nav class="pagination" aria-label="Quest pagination">
        <div class="pagination__info">
          全 <%= @total_count %> 件中 <%= (@page - 1) * @per_page + 1 %>-<%= [@page * @per_page, @total_count].min %> 件目を表示
        </div>
        <div class="pagination__links">
          <% if @page > 1 %>
            <%= link_to "◀ 前へ", quests_path(status: @status_filter, page: @page - 1), class: "btn btn--secondary btn--small", data: { turbo_frame: "quests_content" } %>
          <% else %>
            <span class="btn btn--secondary btn--small disabled" aria-disabled="true">◀ 前へ</span>
          <% end %>

          <span class="pagination__pages">
            <% pagination_page_numbers(@page, @total_pages).each do |p| %>
              <% if p == :gap %>
                <span class="pagination__gap">…</span>
              <% elsif p == @page %>
                <span class="pagination__page active"><%= p %></span>
              <% else %>
                <%= link_to p, quests_path(status: @status_filter, page: p), class: "pagination__page", data: { turbo_frame: "quests_content" } %>
              <% end %>
            <% end %>
          </span>

          <% if @page < @total_pages %>
            <%= link_to "次へ ▶", quests_path(status: @status_filter, page: @page + 1), class: "btn btn--secondary btn--small", data: { turbo_frame: "quests_content" } %>
          <% else %>
            <span class="btn btn--secondary btn--small disabled" aria-disabled="true">次へ ▶</span>
          <% end %>
        </div>
      </nav>
    <% elsif @total_count > 0 %>
      <div class="pagination__info pagination__info--single">
        全 <%= @total_count %> 件
      </div>
    <% end %>
  <% end %>
<% end %>
