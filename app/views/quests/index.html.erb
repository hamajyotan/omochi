<% content_for :title, "Quests | omochi" %>

<%= turbo_stream_from :quests %>

<div class="page-header">
  <h1>Quests</h1>
  <nav class="status-filters" aria-label="Status filter">
    <%= link_to "All", quests_path, class: ("active" if @status_filter.nil?) %>
    <% Quest.statuses.each_key do |status| %>
      <%= link_to status, quests_path(status: status), class: ("active" if @status_filter == status) %>
    <% end %>
  </nav>
</div>

<% if @quests.empty? %>
  <p class="empty">Quest はまだありません。<%= link_to "新しい Quest を作成", new_quest_path %></p>
<% else %>
  <table class="table">
    <thead>
      <tr>
        <th>Quest ID</th>
        <th>Title</th>
        <th>Status</th>
        <th>Updated</th>
      </tr>
    </thead>
    <tbody id="quests_rows">
      <% @quests.each do |quest| %>
        <%= render "quests/quest_row", quest: quest %>
      <% end %>
    </tbody>
  </table>
<% end %>
